{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "__QOLLECT_STORE__": "readonly",
    "__TAURI__": "readonly"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "src-tauri/**",
    "src/ocr-integration-example.js"
  ],
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "off",
    "no-control-regex": "off",
    "no-unused-expressions": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  }
}
