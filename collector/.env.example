# Replace this with a long random value before starting the service.
QOLLECT_TOKEN=change-me

# Optional image override, for example a local mirror.
# QOLLECT_IMAGE=ghcr.io/zongqir/qollect-collector:latest

# The day boundary used for archive directories.
QOLLECT_TIMEZONE=UTC

# Delete JSONL files older than this many days.
QOLLECT_RETENTION_DAYS=30

# Text longer than this is stored as a preview only.
QOLLECT_MAX_TEXT_CHARS=2000
QOLLECT_PREVIEW_CHARS=200

# Localhost port used by the default Compose file for an existing reverse proxy.
QOLLECT_PORT=18080

# Required only by docker-compose.standalone.yml.
QOLLECT_DOMAIN=collector.example.com
