{
  "name": "qollect",
  "version": "0.5.6",
  "description": "Qollect - cross-platform clipboard manager",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "vite",
    "dev:ensure": "node scripts/ensure-dev-server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint:styles": "node scripts/check-style-tokens.mjs --mode=report",
    "lint:styles:strict": "node scripts/check-style-tokens.mjs --mode=strict",
    "lint:styles:baseline": "node scripts/check-style-tokens.mjs --mode=report --update-baseline",
    "visual:baseline:capture": "node scripts/visual-regression/capture.mjs --mode=baseline --clean",
    "visual:current:capture": "node scripts/visual-regression/capture.mjs --mode=current --clean",
    "visual:diff": "node scripts/visual-regression/compare.mjs",
    "visual:check": "npm run visual:current:capture && npm run visual:diff",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@preact/compat": "^18.3.1",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "highlight.js": "^11.11.1",
    "i18next": "^25.8.6",
    "linkifyjs": "^4.3.2",
    "lucide-react": "^0.564.0",
    "pdfjs-dist": "^5.4.624",
    "preact": "^10.28.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-file-icon": "^1.6.0",
    "react-i18next": "^16.5.4",
    "react-virtuoso": "^4.18.1",
    "vite": "^7.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.5",
    "sharp": "^0.34.5"
  }
}
