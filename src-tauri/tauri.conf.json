{
  "productName": "Qollect",
  "version": "0.2.1",
  "identifier": "com.qollect.clipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Qollect Team",
    "copyright": "Copyright (c) 2024-2026 Qollect Team",
    "category": "Utility",
    "shortDescription": "Modern cross-platform clipboard manager",
    "longDescription": "Qollect is a modern, cross-platform clipboard manager built with Rust and React. Features include clipboard history, AI-powered tagging, OCR support, and MCP integration.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://dl.135070.xyz/latest.json",
        "https://github.com/zongqir/qollect/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3MTQwMUQ0OTFCQzE1OUUKUldTZUZieVIxQUVVbHd4Z2JhKzlTNHJkRjZNb1hldDZ1ZzcwTkdPUTZiWWZORTdGajd5cG9tTDUK"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qollect",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "devtools": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:window:allow-set-always-on-top",
            "core:window:allow-minimize",
            "core:window:allow-maximize",
            "core:window:allow-close",
            "core:window:allow-toggle-maximize",
            "core:window:allow-set-size",
            "core:window:allow-inner-size",
            "core:window:allow-set-min-size",
            "core:window:allow-get-all-windows",
            "core:window:allow-unminimize",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "core:window:allow-hide",
            "core:window:allow-is-visible",
            "core:window:allow-is-maximized",
            "core:window:allow-is-minimized",
            "core:window:allow-cursor-position",
            "core:window:allow-available-monitors",
            "global-shortcut:allow-register",
            "global-shortcut:allow-unregister",
            "global-shortcut:allow-is-registered",
            "core:webview:allow-create-webview-window",
            "core:event:default",
            "core:path:default",
            "core:app:default",
            "core:tray:default",
            "core:menu:default",
            "updater:default"
          ]
        },
        {
          "identifier": "preview-capability",
          "windows": [
            "preview-*"
          ],
          "permissions": [
            "core:window:allow-close",
            "core:window:allow-set-always-on-top",
            "core:event:default"
          ]
        },
        {
          "identifier": "quick-input-capability",
          "windows": [
            "quick-input"
          ],
          "permissions": [
            "core:window:allow-close",
            "core:window:allow-set-always-on-top",
            "core:window:allow-start-dragging",
            "core:event:default"
          ]
        },
        {
          "identifier": "widget-capability",
          "windows": [
            "widget"
          ],
          "permissions": [
            "core:window:allow-close",
            "core:window:allow-set-always-on-top",
            "core:window:allow-start-dragging",
            "core:event:default"
          ]
        }
      ]
    }
  }
}
